# Public canonical URL used for metadata only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only URL for the Python prediction service. Never prefix with NEXT_PUBLIC_.
KLR_API_URL=http://127.0.0.1:8000

# Comma-separated browser origins allowed when calling FastAPI directly.
KLR_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
